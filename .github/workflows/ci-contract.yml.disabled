name: CI — Contract Tests

on:
  workflow_dispatch:
    inputs:
      go_url:
        description: "Go service URL"
        default: "http://elitea-main:8080"
      legacy_url:
        description: "Legacy service URL"
        default: "http://pylon-main:8000"
  schedule:
    - cron: "23 6 * * 1" # Mondays at 06:23 UTC

concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: true

jobs:
  contract:
    name: Contract Parity Tests
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-go@v6
        with:
          go-version: "1.23"
          cache-dependency-path: services/elitea-main/go.sum

      - name: Run contract tests
        env:
          CONTRACT_GO_URL: ${{ inputs.go_url || 'http://elitea-main:8080' }}
          CONTRACT_LEGACY_URL: ${{ inputs.legacy_url || 'http://pylon-main:8000' }}
          CONTRACT_AUTH_TOKEN: ${{ secrets.CONTRACT_AUTH_TOKEN }}
          CONTRACT_PROJECT_ID: ${{ secrets.CONTRACT_PROJECT_ID }}
        run: |
          cd services/elitea-main
          go test -v -count=1 -timeout=60s ./tests/contract/
