# syntax=docker/dockerfile:1.7
#
# pylon-indexer: agent runtime & SDK execution
# Uses the shared pylon base image; plugins are loaded at startup from git (bootstrap).
#

ARG PYLON_VERSION=1.2.25
FROM ghcr.io/eliteaai/pylon:${PYLON_VERSION}

WORKDIR /data

# Copy default configs (overridable via volume mount / ConfigMap)
COPY configs/ /data/configs/

# Copy pylon seed config
COPY pylon.yml /data/pylon.yml

# Startup guard for SECRETS_MASTER_KEY, then the stock pylon entrypoint. See
# entrypoint.sh for why the check cannot wait for the first vault read.
COPY entrypoint.sh /usr/local/sbin/pylon-indexer-entrypoint.sh
RUN chmod 0755 /usr/local/sbin/pylon-indexer-entrypoint.sh

ENV NAME=pylon-indexer \
    PYLON_WEB_RUNTIME=waitress \
    PYLON_CONFIG_SEED=file:/data/pylon.yml

EXPOSE 8080

CMD ["bash", "/usr/local/sbin/pylon-indexer-entrypoint.sh"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1
