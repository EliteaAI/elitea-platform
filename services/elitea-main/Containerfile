# syntax=docker/dockerfile:1.7

# ── Stage 1: admin UI builder ─────────────────────────────────────────────────
# The admin SPA is `apps/elitea-web`'s admin build target (src/entries/admin),
# served by internal/api/adminui at /admin/app.
#
# It used to be the `apps/admin-ui` git submodule, and only the E2E image used
# the elitea-web build — so E2E tested one artefact while releases shipped
# another (issue #122). Unit A14 (#200) ported the admin console into
# elitea-web, so the split has no reason left to exist: the submodule is gone
# (#199) along with its orphaned pin that broke every release (#8), and every
# target below builds from this one stage.
FROM node:24-alpine AS admin-builder

WORKDIR /build

# npm ci + package-lock.json: apps/elitea-web has no packageManager field and
# ships a package-lock.json, so npm is the package manager, not pnpm/yarn.
COPY apps/elitea-web/package.json apps/elitea-web/package-lock.json ./
RUN npm ci

COPY apps/elitea-web/index.html apps/elitea-web/tsconfig.json apps/elitea-web/vite.config.ts ./
COPY apps/elitea-web/src/ ./src/

# vite.config.ts `admin` mode: root src/entries/admin, base '/admin/app/',
# outDir dist/admin.
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build:admin

# ── Stage 2: Go builder ───────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

WORKDIR /src

ARG VERSION=dev

# Preserve the repository-relative module layout because elitea-main replaces
# the generated protobuf module with ../../libs/proto/gen/go, and (issue #250)
# the observability module with ../../libs/go/observability.
COPY libs/proto/gen/go ./libs/proto/gen/go
COPY libs/go/observability ./libs/go/observability
COPY services/elitea-main/go.mod services/elitea-main/go.sum ./services/elitea-main/
WORKDIR /src/services/elitea-main
RUN go mod download

COPY services/elitea-main/ ./

ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/elitea-main ./cmd/elitea-main && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/elitea-migrate ./cmd/elitea-migrate && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/elitea-auth-validate ./cmd/elitea-auth-validate && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/index-v2-preflight ./cmd/index-v2-preflight && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/cutover-ctl ./cmd/cutover-ctl

# ── Stage 3: vulnerability scan ───────────────────────────────────────────────
FROM aquasec/trivy:latest AS scanner
COPY --from=builder /out/ /
# Fail the build on HIGH/CRITICAL vulnerabilities in shipped binaries.
RUN trivy rootfs --exit-code 1 --severity HIGH,CRITICAL --no-progress /

# ── Stage 4: shared runtime image ─────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

COPY --from=builder /out/ /

ENV ADMIN_UI_STATIC_DIR=/data/admin_ui/static/dist

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/elitea-main", "-healthcheck"]

ENTRYPOINT ["/elitea-main"]

# ── Stage 5: mixed Centry deployment ──────────────────────────────────────────
# `/nonexistent` is deliberate and stays that way. In deploy/centry-hybrid the
# traefik router sends only /healthz and a short list of API paths to
# elitea-main; `/admin/app` falls through the `current-platform` PathPrefix(`/`)
# router to pylon_main, which serves the legacy admin_ui plugin. This image is
# not an admin server, so it carries no admin bundle.
FROM runtime AS hybrid

ENV ADMIN_UI_STATIC_DIR=/nonexistent

# ── Stage 6: E2E test image ───────────────────────────────────────────────────
# Byte-identical to `final` below, which derives from it. The separate name is
# kept only because deploy/docker-compose.e2e-standalone.yml selects
# `target: e2e`; keeping `final` a child of this stage makes "E2E exercises the
# artefact that ships" true by construction rather than by convention (#122).
FROM runtime AS e2e

COPY --from=admin-builder /build/dist/admin /data/admin_ui/static/dist

# ── Stage 7: standalone final image (default target) ──────────────────────────
# Last stage, so a `docker build` with no --target still produces the shipping
# image. publish.yml and docker-bake.hcl also name it explicitly.
FROM e2e AS final
