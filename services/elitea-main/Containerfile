# syntax=docker/dockerfile:1.7

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

WORKDIR /src

# This image uses the repository root as its build context because elitea-main
# consumes the checked-in runtime protocol module through a local replace.
COPY services/elitea-main/go.mod services/elitea-main/go.sum ./services/elitea-main/
COPY libs/proto/gen/go/go.mod libs/proto/gen/go/go.sum ./libs/proto/gen/go/
RUN cd services/elitea-main && go mod download

COPY libs/proto/gen/go ./libs/proto/gen/go
COPY services/elitea-main ./services/elitea-main

ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN cd services/elitea-main && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
      go build -trimpath -ldflags="-s -w" -o /out/elitea-main ./cmd/elitea-main && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
      go build -trimpath -ldflags="-s -w" -o /out/elitea-migrate ./cmd/elitea-migrate && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
      go build -trimpath -ldflags="-s -w" -o /out/elitea-auth-validate ./cmd/elitea-auth-validate

# ── Stage 2: vulnerability scan ───────────────────────────────────────────────
FROM aquasec/trivy:latest AS scanner
COPY --from=builder /out/elitea-main /scan/elitea-main
COPY --from=builder /out/elitea-migrate /scan/elitea-migrate
COPY --from=builder /out/elitea-auth-validate /scan/elitea-auth-validate
# Fail the build on HIGH/CRITICAL vulnerabilities in the binary.
RUN trivy rootfs --exit-code 1 --severity HIGH,CRITICAL --no-progress /scan

# ── Stage 3: final runtime image ──────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot AS final

COPY --from=scanner /scan/elitea-main /elitea-main
COPY --from=scanner /scan/elitea-migrate /elitea-migrate
COPY --from=scanner /scan/elitea-auth-validate /elitea-auth-validate

EXPOSE 8080

ENTRYPOINT ["/elitea-main"]
