FROM python:3.12.10-slim AS build

ARG ELITEA_SDK_REVISION=48c51a16634a9924f6c5d5313c3bacedb0b5b56b
ARG ELITEA_SDK_ARCHIVE_SHA256=85e8b2396dc86ea8e7d2098a41e12b228fa1995a0be8ff0143af6d3df49b6d61
ARG PYTESSERACT_WHEEL_SHA256=7a99c6c2ac598360693d83a416e36e0b33a67638bb9d77fdcac094a3589d4b34

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      build-essential \
      git \
      libcairo2-dev \
      libpango1.0-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY libs/proto ./libs/proto
COPY services/elitea-worker-python ./services/elitea-worker-python
RUN git clone \
      --filter=blob:none \
      --no-checkout \
      https://github.com/EliteaAI/elitea-sdk.git \
      ./elitea-sdk \
    && git -C ./elitea-sdk checkout --detach "${ELITEA_SDK_REVISION}" \
    && test "$(git -C ./elitea-sdk archive --format=tar HEAD | sha256sum | cut -d ' ' -f 1)" = "${ELITEA_SDK_ARCHIVE_SHA256}"
RUN python -m pip wheel \
    --wheel-dir /wheels \
    "elitea-sdk @ file:///build/elitea-sdk" \
    ./libs/proto \
    "./services/elitea-worker-python[indexing-current]" \
    && test "$(sha256sum /wheels/pytesseract-0.3.13-py3-none-any.whl | cut -d ' ' -f 1)" = "${PYTESSERACT_WHEEL_SHA256}"

FROM python:3.12.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      libcairo2 \
      fonts-dejavu-core \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      poppler-utils \
      tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 elitea \
    && useradd --system --uid 10001 --gid elitea --home-dir /nonexistent --shell /usr/sbin/nologin elitea

COPY --from=build /wheels /wheels
COPY testdata/proto/runtime/v1 /opt/elitea/conformance
RUN python -m pip install \
    --no-cache-dir \
    --disable-pip-version-check \
    --no-index \
    --find-links /wheels \
    "elitea-worker-python[indexing-current]==0.1.0" \
    && python -m pip check \
    && python -c "from elitea_worker.indexing_runtime_capabilities import require_indexing_runtime_capabilities; print('indexing-runtime-profile=' + require_indexing_runtime_capabilities())" \
    && rm -rf /wheels

USER 10001:10001
ENTRYPOINT ["elitea-worker"]
