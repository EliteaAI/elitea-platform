FROM python:3.12.10-slim AS build

ARG ELITEA_SDK_REVISION=a78d3654f99d8ff89ca7233f20a66d676e564f79

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY libs/proto ./libs/proto
COPY services/elitea-worker-python ./services/elitea-worker-python
RUN python -m pip wheel \
    --wheel-dir /wheels \
    "elitea-sdk @ git+https://github.com/EliteaAI/elitea-sdk.git@${ELITEA_SDK_REVISION}" \
    ./libs/proto \
    ./services/elitea-worker-python

FROM python:3.12.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system --gid 10001 elitea \
    && useradd --system --uid 10001 --gid elitea --home-dir /nonexistent --shell /usr/sbin/nologin elitea

COPY --from=build /wheels /wheels
COPY testdata/proto/runtime/v1 /opt/elitea/conformance
RUN python -m pip install \
    --no-cache-dir \
    --disable-pip-version-check \
    --no-index \
    --find-links /wheels \
    elitea-worker-python==0.1.0 \
    && python -m pip check \
    && rm -rf /wheels

USER 10001:10001
ENTRYPOINT ["elitea-worker"]
