FROM python:3.12.10-slim AS build

ARG ELITEA_SDK_REVISION=b5113a129329b85d23c2d5c2bf55f18e307414ec
ARG ELITEA_SDK_ARCHIVE_SHA256=df398b4a378e7b88ea3b72511e31de13a17a02159c69fbada6f0b948a0ecf2d7
ARG ELITEA_SDK_VERSION=0.9.8

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      build-essential \
      git \
      libcairo2-dev \
      libpango1.0-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY libs/proto ./libs/proto
COPY services/elitea-worker-python ./services/elitea-worker-python
RUN git clone \
      --filter=blob:none \
      --no-checkout \
      https://github.com/EliteaAI/elitea-sdk.git \
      ./elitea-sdk \
    && git -C ./elitea-sdk checkout --detach "${ELITEA_SDK_REVISION}" \
    && test "$(git -C ./elitea-sdk archive --format=tar HEAD | sha256sum | cut -d ' ' -f 1)" = "${ELITEA_SDK_ARCHIVE_SHA256}"
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip download \
      --dest /sources \
      --no-binary=:all: \
      --no-deps \
      "FigmaPy==2018.1.0" \
    && python ./services/elitea-worker-python/scripts/verify_locked_artifacts.py \
      ./services/elitea-worker-python/elitea-sdk.lock.json \
      /sources \
      verified_source_archives \
    && python -m pip wheel \
      --wheel-dir /wheels \
      --no-deps \
      /sources/FigmaPy-2018.1.0.tar.gz
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip wheel \
    --no-cache-dir \
    --wheel-dir /wheels \
    --no-deps \
    ./elitea-sdk \
    && test -f "/wheels/elitea_sdk-${ELITEA_SDK_VERSION}-py3-none-any.whl" \
    && python -m pip wheel \
    --wheel-dir /wheels \
    --find-links /wheels \
    --prefer-binary \
    "elitea-sdk @ file:///wheels/elitea_sdk-${ELITEA_SDK_VERSION}-py3-none-any.whl" \
    ./libs/proto \
    "./services/elitea-worker-python[agent-current,indexing-current]" \
    && python ./services/elitea-worker-python/scripts/verify_locked_artifacts.py \
      ./services/elitea-worker-python/elitea-sdk.lock.json \
      /wheels \
      verified_wheels

FROM python:3.12.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AZURE_DEVOPS_CACHE_DIR=/tmp/.azure-devops

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
      libcairo2 \
      fonts-dejavu-core \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      poppler-utils \
      tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 elitea \
    && useradd --system --uid 10001 --gid elitea --home-dir /nonexistent --shell /usr/sbin/nologin elitea

COPY --from=build /wheels /wheels
COPY testdata/proto/runtime/v1 /opt/elitea/conformance
RUN python -m pip install \
    --no-cache-dir \
    --disable-pip-version-check \
    --no-index \
    --find-links /wheels \
    "elitea-worker-python[agent-current,indexing-current]==0.1.0" \
    && python -m pip check \
    && python -c "from elitea_worker.indexing_runtime_capabilities import require_indexing_runtime_capabilities; print('indexing-runtime-profile=' + require_indexing_runtime_capabilities())" \
    && python -c "from elitea_worker.agent_current_runtime_capabilities import require_agent_current_runtime_capabilities; print('agent-current-runtime-profile=' + require_agent_current_runtime_capabilities())" \
    && rm -rf /wheels

USER 10001:10001
ENTRYPOINT ["elitea-worker"]
