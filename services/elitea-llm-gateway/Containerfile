# syntax=docker/dockerfile:1.7
#
# elitea-llm-gateway is a STANDALONE Go module pinned to Go 1.26.4 (required by
# github.com/maximhq/bifrost/core). It is deliberately NOT part of the root
# go.work workspace — that workspace stays on Go 1.25.8 for elitea-main and
# elitea-scheduler, whose toolchain must not be bumped. The build context is
# this module directory only, so it never inherits the workspace toolchain.
FROM golang:1.26.4-alpine AS builder
WORKDIR /src

# Cache module downloads separately from source.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS=linux
ARG TARGETARCH=amd64
# VERSION is declared for build-time labelling only; no version symbol exists in
# the source tree, so it is NOT injected via -X.
ARG VERSION=dev
# GOFLAGS=-mod=mod keeps the standalone module build independent of any parent
# go.work the host may set; GOWORK=off guarantees the workspace is not consulted.
RUN CGO_ENABLED=0 GOWORK=off GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/elitea-llm-gateway ./cmd/elitea-llm-gateway

# ── vulnerability scan ────────────────────────────────────────────────────────
FROM aquasec/trivy:latest AS scanner
COPY --from=builder /out/elitea-llm-gateway /elitea-llm-gateway
# Fail the build on HIGH/CRITICAL vulnerabilities in the binary.
RUN trivy rootfs --exit-code 1 --severity HIGH,CRITICAL --no-progress /

# ── final runtime image ───────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot AS final
COPY --from=builder /out/elitea-llm-gateway /elitea-llm-gateway
# distroless contains no shell, wget, or curl, so a CMD/CMD-SHELL HEALTHCHECK
# cannot be used. Kubernetes MUST configure httpGet probes against :8083/healthz
# (liveness) and :8083/readyz (readiness) instead of relying on Docker's
# HEALTHCHECK.
HEALTHCHECK NONE
EXPOSE 8083
ENTRYPOINT ["/elitea-llm-gateway"]
