            "title": "Parity API",
            "version": "1.0.0"
          },
          "openapi": "3.0.0",
          "paths": {
            "/pets/{pet_id}": {
              "get": {
                "description": "Get one pet",
                "operationId": "getPet",
                "parameters": [
                  {
                    "in": "path",
                    "name": "pet_id",
                    "required": true,
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "in": "query",
                    "name": "include_history",
                    "required": false,
                    "schema": {
                      "type": "boolean"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "OK"
                  }
                }
              }
            }
          },
          "servers": [
            {
              "url": "https://example.invalid"
            }
          ]
