                "title": "Headers"
              },
              "include_history": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "(query)\nType: boolean",
                "title": "Include History"
              },
              "pet_id": {
                "description": "(path)\nType: string\nRequired: true",
                "title": "Pet Id",
                "type": "string"
              },
              "regexp": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Regular expression to remove from the final output (optional)",
                "title": "Regexp"
              }
            },
            "required": [
              "pet_id"
            ],
            "title": "OpenApi_getPet_Params",
            "type": "object"
          }
        },
        "tools": [
          {
            "description": "GET /pets/{pet_id}\nGet one pet\nHow to call:\n- Provide path/query parameters as named arguments.\n- Use `headers` only for per-call extra headers; base/toolkit headers (including auth) are already applied.",
            "name": "getPet"
          }
        ]
