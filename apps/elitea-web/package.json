{
  "name": "elitea-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Elitea web UI — drop-in replacement for apps/elitea-ui (spec: elitea-docs ui/spec-ui-reimplementation.md)",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:admin && npm run build:maintenance",
    "build:app": "vite build",
    "build:admin": "vite build --mode admin",
    "build:maintenance": "vite build --mode maintenance",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:storybook": "vitest run --config vitest.config.ts --project storybook",
    "theme-gate": "node scripts/theme-gate.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.5.7",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@mui/system": "9.2.0",
    "@mui/x-data-grid": "9.10.1",
    "@mui/x-date-pickers": "9.10.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@uiw/react-codemirror": "4.25.11",
    "@xyflow/react": "12.11.2",
    "date-fns": "4.1.0",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-i18next": "17.0.11",
    "recharts": "3.10.1",
    "simplebar-react": "3.3.2",
    "socket.io-client": "4.8.3",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/react-vite": "10.5.4",
    "@swc/core": "1.15.46",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.1.0",
    "eslint-plugin-i18next": "6.1.5",
    "js-yaml": "5.2.2",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "msw": "2.15.0",
    "orval": "8.23.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "storybook": "10.5.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vite-plugin-svgr": "5.2.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
