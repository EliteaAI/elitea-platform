    // (analytics, apps, credentials, mcps, notifications, user-public,
    // app-shell, create-button, sidebar) aren't imported by anything yet
    // because the route-wiring pass (pointing each src/routes/**
    // placeholder RouteShell at its real page) hasn't landed. Same
    // mechanism as the two entries above: marking each domain's index.ts
    // an entry point makes everything it re-exports (including things it
    // re-exports FROM a model/lib file, e.g. widgets/app-shell/index.ts ->
    // model/navBlocker.store.ts's createNavBlockerStore) reachable too.
    "src/features/**/index.ts",
    "src/pages/**/index.ts",
    "src/widgets/**/index.ts",
