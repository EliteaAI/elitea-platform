apps/admin-ui/static/dist/assets/*.js.map
**/__pycache__/
*.py[cod]

# Local data (dumps, storage blobs)
deploy/data/staging/
deploy/data/production/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Go binaries
/services/*/cmd/*/__debug_bin*
/services/elitea-main/elitea-main
/services/elitea-main/cutover-ctl
/services/elitea-scheduler/elitea-scheduler
bin/
.claude/settings.json

